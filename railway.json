{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "services": {
    "web": {
      "serviceType": "web",
      "domains": [],
      "ports": [
        {
          "port": 8080,
          "protocol": "HTTP"
        }
      ]
    }
  }
}
