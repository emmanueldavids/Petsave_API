{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "./mvnw clean package -DskipTests",
    "watchPatterns": [
      "src/**",
      "pom.xml"
    ]
  },
  "deploy": {
    "startCommand": "java -jar target/petsave-0.0.1-SNAPSHOT.jar --spring.profiles.active=railway",
    "healthcheckPath": "/api/test/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "web": {
      "serviceType": "web",
      "domains": []
    }
  }
}
